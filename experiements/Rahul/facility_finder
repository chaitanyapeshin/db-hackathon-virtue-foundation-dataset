# MAGIC %md
# MAGIC ## 8. Ranking: trading evidence against distance
# MAGIC `proximity = 100 · exp(−distance / scale)`. At distance 0 this is 100. At `scale` km it is about 37. At 3× `scale` it is about 5.
# MAGIC We use an exponential so that nearby differences matter most and far-away differences fade out.
# MAGIC * urgent services: `scale = 25 km`, search radius up to 150 km
# MAGIC * planned services: `scale = 75 km`, search radius up to 400 km
# MAGIC
# MAGIC `final = 0.6 · evidence + 0.4 · proximity`.
# MAGIC **The trade-off we chose:** evidence gets slightly more weight than distance, because sending a patient to a closer place
# MAGIC that turns out *not* to offer the service costs more time than a slightly longer trip to a well-evidenced one.
# MAGIC A facility needs **at least one strong hit** to qualify. Support-only facilities are shown separately as "unverified leads",
# MAGIC and only if there are fewer than 3 qualified options. If nothing is within the radius, we double the radius once and say so.

# COMMAND ----------

W_EVIDENCE, W_PROX = 0.6, 0.4

def recommend(service_text, location_text, top_k=5):
    svc = resolve_service(service_text); spec = SERVICES[svc]
    loc = resolve_location(location_text)
    scale, radius = (25, 150) if spec["urgent"] else (75, 400)

    # Use real coordinates when valid; otherwise fall back to the city centre (and say so in warnings)
    lat = fac["lat"].fillna(fac["c_lat"]); lon = fac["lon"].fillna(fac["c_lon"])
    dist = pd.Series(haversine_km(loc["lat"], loc["lon"], lat, lon), index=fac.index)

    notes = []
    for attempt in range(2):
        near = fac[dist <= radius]
        if len(near): break
        radius *= 2; notes.append(f"Nothing within the first radius; widened the search to {radius} km.")

    rows = []
    for idx, r in near.iterrows():
        s = score_facility(r, spec)
        if not s["evidence"]: continue
        d = float(dist[idx])
        prox = 100 * math.exp(-d / scale)
        rows.append({**{k: r[k] for k in ["row_id", "name", "city", "state", "postcode", "address", "source_url", "name_n", "dup_key", "doctors", "capacity", "year", "coords_ok", "phone", "website", "facility_type", "last_post"]},
                     **s, "distance_km": round(d, 1), "proximity_score": round(prox, 1),
                     "final_score": round(W_EVIDENCE * s["evidence_score"] + W_PROX * prox, 1)})
    res = pd.DataFrame(rows)
    if res.empty:
        return dict(service=svc, location=loc, results=res, leads=res, notes=notes + ["No facility mentions this service nearby."])
    # collapse duplicate records of the same facility: keep the best-scoring row
    res = res.sort_values("final_score", ascending=False).drop_duplicates("dup_key")
    qualified = res[res["has_strong"]].head(top_k)
    leads = res[~res["has_strong"]].head(max(0, 3 - len(qualified))) if len(qualified) < 3 else res.iloc[0:0]
    return dict(service=svc, location=loc, results=qualified, leads=leads, notes=notes,
                params=dict(scale_km=scale, radius_km=radius, w_evidence=W_EVIDENCE, w_proximity=W_PROX))

