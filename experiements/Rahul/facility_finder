# MAGIC %md
# MAGIC ## 13. (Optional) An LLM second opinion on the top results, with a hallucination guard
# MAGIC Keyword rules can't read context ("we refer dialysis patients to X"). An LLM can. Free Edition has pay-per-token
# MAGIC **Foundation Model** endpoints (see **Serving** in the sidebar for the exact names in your workspace). The SQL function `ai_query` calls one.
# MAGIC
# MAGIC The guard: we ask for a verdict **plus an exact quote**, and we **accept the verdict only if that quote really appears in the record**.
# MAGIC An LLM can invent text, but it can't fake a substring check. The LLM only adjusts the label. It never adds facilities.

# COMMAND ----------

LLM_ENDPOINT = "databricks-meta-llama-3-3-70b-instruct"   # change to a name listed under Serving if this one isn't available

def llm_verify(out, service):
    if out["results"].empty: return out["results"]
    ids = set(out["results"]["row_id"])
    sub = fac[fac["row_id"].isin(ids)].copy()
    sub["record"] = sub.apply(lambda r: f"NAME: {r['name']}\nPROCEDURES: {r['procedure']}\nEQUIPMENT: {r['equipment']}\n"
                                         f"CAPABILITIES: {r['capability']}\nSPECIALTIES: {r['specialties']}\nDESCRIPTION: {r['description'][:2500]}", axis=1)
    spark.createDataFrame(sub[["row_id", "record"]]).createOrReplaceTempView("cands")
    prompt = (f"You verify hospital records. Does this facility itself provide {service}? "
              "Answer ONLY JSON: {\"verdict\": \"yes\"|\"no\"|\"unclear\", \"quote\": \"<exact words copied from the record>\"}. Record:\\n")
    resp = spark.sql(f"""SELECT row_id, record, ai_query('{LLM_ENDPOINT}', concat('{prompt.replace("'", "''")}', record)) AS answer FROM cands""").toPandas()
    def check(r):
        try:
            j = json.loads(re.search(r"\{.*\}", r["answer"], re.S).group(0))
            ok = j.get("quote", "").strip() and j["quote"].strip().lower() in r["record"].lower()
            return pd.Series({"llm_verdict": j.get("verdict") if ok else "rejected (quote not found in record)", "llm_quote": j.get("quote")})
        except Exception:
            return pd.Series({"llm_verdict": "unparseable", "llm_quote": None})
    return resp.join(resp.apply(check, axis=1))[["row_id", "llm_verdict", "llm_quote"]].merge(
        out["results"][["row_id", "name", "confidence"]], on="row_id")

try:
    display(llm_verify(out, out["service"]))
except Exception as err:
