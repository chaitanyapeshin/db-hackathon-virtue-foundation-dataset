# MAGIC %md
# MAGIC ## 2. Find the columns we need, without hard-coding names
# MAGIC The brief describes the fields (name, city, postcode, lat/lon, specialties, capability, procedure, equipment, description,
# MAGIC doctors, beds/capacity, source URLs) but the exact column names can vary (`address_city` vs `city`).
# MAGIC `pick()` tries a list of candidate names, so the notebook still works if a column is named slightly differently.
# MAGIC **Check the printed mapping.** If something shows `None` and you know the real name, add it to the list.

# COMMAND ----------

import re, json, math, html
import numpy as np
import pandas as pd

def pick(cols, candidates, fuzzy=True):
    low = {c.lower(): c for c in cols}
    for cand in candidates:
        if cand.lower() in low:
            return low[cand.lower()]
    if not fuzzy:
        return None
    # fallback: substring match (e.g. 'address_zipOrPostcode' for 'postcode')
    for cand in candidates:
        for c in cols:
            if cand.lower() in c.lower():
                return c
    return None

COLS = {
    "id":          ["unique_id", "pk_unique_id", "facility_id", "id"],
    "name":        ["name", "facility_name", "organization_name"],
    "city":        ["address_city", "city"],
    "district":    ["address_district", "district"],
    "state":       ["address_stateOrRegion", "state", "address_state"],
    "postcode":    ["address_zipOrPostcode", "postcode", "pincode", "pin_code", "zip"],
    "address":     ["address_line1", "address", "full_address"],
    "address2":    ["address_line2"],
    "address3":    ["address_line3"],
    "lat":         ["latitude", "lat"],
    "lon":         ["longitude", "lon", "lng"],
    "specialties": ["specialties", "specialty"],
    "capability":  ["capability", "capabilities"],
    "procedure":   ["procedure", "procedures"],
    "equipment":   ["equipment"],
    "description": ["description", "organizationDescription"],
    "doctors":     ["numberDoctors", "number_doctors", "doctors"],
    "capacity":    ["capacity", "beds", "number_beds"],
    "year":        ["yearEstablished", "year_established"],
    "source_url":  ["source_urls", "source_url"],
    "website":     ["officialWebsite", "websites"],
    "phone":       ["officialPhone", "phone_numbers", "phone"],
    "facility_type": ["facilityTypeId", "facility_type"],
    "org_type":    ["organization_type"],
    "cluster":     ["cluster_id"],
    "last_post":   ["post_metrics_most_recent_social_media_post_date"],
}
NO_FUZZY = {"id", "address", "address2", "address3", "district", "cluster", "org_type"}   # substring matching would grab the wrong column for these
C = {k: pick(list(raw_pdf.columns), v, fuzzy=k not in NO_FUZZY) for k, v in COLS.items()}
for k, v in C.items():
    print(f"{k:14s} -> {v}")

