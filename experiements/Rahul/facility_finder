# MAGIC %md
# MAGIC ## 9. Presenting results for non-technical users
# MAGIC `displayHTML` renders plain HTML cards in the notebook output. Each card answers **WHY** (quoted evidence with the field it came from)
# MAGIC and **HOW** (the score breakdown), and uses plain-language confidence and warnings.

# COMMAND ----------

CONF_COLOR = {"High": "#1a7f37", "Medium": "#9a6700", "Low": "#cf222e"}

def render(out):
    e = html.escape
    loc, svc = out["location"], out["service"]
    parts = [f"""<div style="font-family:system-ui,sans-serif;max-width:900px">
    <h2 style="margin-bottom:4px">{e(svc.title())} near {e(loc['label'])}</h2>
    <div style="color:#555;font-size:13px">Location used: {e(loc['precision'])}. Distances are straight-line; road distance is usually 30–50% longer.
    Always phone the facility to confirm before travelling. This data comes from websites and has not been verified.</div>"""]
    for n in out["notes"]:
        parts.append(f"<p><b>Note:</b> {e(n)}</p>")

    def sv(x):
        return "" if x is None or (isinstance(x, float) and x != x) else str(x)

    def card(i, r, lead=False):
        ev = "".join(f"<li><b>{e(x['field'])}</b> ({'direct' if x['kind']=='strong' else 'indirect'}): “{e(x['quote'][:220])}”</li>" for x in r["evidence"])
        wr = "".join(f"<li>{e(w)}</li>" for w in r["warnings"]) or "<li>None found</li>"
        bd = "".join(f"<li>{e(b)}</li>" for b in r["breakdown"])
        src = f'<a href="{e(sv(r["source_url"]))}" target="_blank">source</a>' if sv(r["source_url"]) else "no source URL in record"
        addr = ", ".join(sv(x) for x in [r["address"], r["city"], r["state"], r["postcode"]] if sv(x))
        conf = "Unverified lead" if lead else r["confidence"] + " confidence"
        color = "#6e7781" if lead else CONF_COLOR[r["confidence"]]
        return f"""<div style="border:1px solid #d0d7de;border-left:6px solid {color};border-radius:6px;padding:12px;margin:12px 0">
        <div style="font-size:17px"><b>{i}. {e(r['name'])}</b> <span style="color:{color};font-weight:600">· {conf}</span></div>
        <div style="color:#444">{e(addr)} · <b>{'' if r['coords_ok'] else '≈'}{r['distance_km']} km</b> away{'' if r['coords_ok'] else ' (estimated from city centre)'} · {src}</div>
        <div style="color:#444;font-size:13px">Type: {e(sv(r['facility_type']) or 'unknown')} · Phone: {e(sv(r['phone']) or 'not listed')}{(' · Beds: ' + str(int(r['capacity']))) if sv(r['capacity']) else ''}{(' · Doctors: ' + str(int(r['doctors']))) if sv(r['doctors']) else ''}{(' · Last social post: ' + e(sv(r['last_post']))) if sv(r['last_post']) else ''}</div>
        <div style="margin-top:6px"><b>WHY this facility. What the record says:</b><ul style="margin:4px 0">{ev}</ul></div>
        <div><b>Cautions:</b><ul style="margin:4px 0">{wr}</ul></div>
        <details><summary><b>HOW it was scored</b>: final {r['final_score']} = 0.6 × evidence {r['evidence_score']} + 0.4 × proximity {r['proximity_score']}</summary>
        <ul>{bd}</ul></details></div>"""

    if out["results"].empty:
        parts.append("<p><b>No facility in the data clearly claims this service nearby.</b></p>")
    for i, (_, r) in enumerate(out["results"].iterrows(), 1):
        parts.append(card(i, r))
    if len(out["leads"]):
        parts.append("<h3>Unverified leads</h3><div style='color:#555'>These mention related services only. Call to ask.</div>")
        for i, (_, r) in enumerate(out["leads"].iterrows(), 1):
            parts.append(card(i, r, lead=True))
    parts.append("</div>")
    return "".join(parts)

