raw_pdf = sdf.toPandas()

# Coverage = share of rows where the column is non-empty. This tells us which fields we can lean on.
def _is_empty(v):
    if v is None: return True
    if isinstance(v, float) and v != v: return True          # NaN
    s = str(v).strip().lower()
    return s in ("", "[]", "null", "none", "nan", "{}")

coverage = {c: round(100 * (1 - raw_pdf[c].map(_is_empty).mean()), 1) for c in raw_pdf.columns}
print(sorted(coverage.items(), key=lambda kv: -kv[1]))

