# MAGIC %md
# MAGIC ## 7. Understanding the location the user typed
# MAGIC Free Edition notebooks have **restricted internet access**, so we can't call an external geocoder such as Google Maps.
# MAGIC Instead we **geocode from the dataset itself**: a city's position is the median coordinate of the facilities in that city.
# MAGIC
# MAGIC Accepted inputs, in order of precision:
# MAGIC 1. `lat,lon`, e.g. `26.9124, 75.7873`: exact
# MAGIC 2. a 6-digit **PIN code**: median of facilities with that PIN. If there are none, we use the first 3 digits (a postal sorting district), which is approximate.
# MAGIC 3. a **city / district / state name**: exact match first, then fuzzy match (handles typos and spellings like "Bengaluru" vs "Bangalore" if both appear in the data)

# COMMAND ----------

import difflib

ALT_NAMES = {"bangalore": "bengaluru", "bombay": "mumbai", "madras": "chennai", "calcutta": "kolkata",
             "gurgaon": "gurugram", "poona": "pune", "trivandrum": "thiruvananthapuram", "baroda": "vadodara"}

def resolve_location(text):
    t = text.strip()
    m = re.match(r"^\s*(-?\d+(\.\d+)?)\s*,\s*(-?\d+(\.\d+)?)\s*$", t)
    if m:
        return dict(lat=float(m.group(1)), lon=float(m.group(3)), label=f"coordinates {t}", precision="exact point")
    digits = re.sub(r"\D", "", t)
    if len(digits) == 6 and len(digits) >= len(t.replace(" ", "")) - 1:
        g = fac[(fac["postcode"] == digits) & fac["coords_ok"]]
        if len(g):
            return dict(lat=g["lat"].median(), lon=g["lon"].median(), label=f"PIN {digits}",
                        precision=f"centre of {len(g)} facilities in PIN {digits}")
        g = fac[fac["postcode"].str.startswith(digits[:3]) & fac["coords_ok"]]
        if len(g):
            return dict(lat=g["lat"].median(), lon=g["lon"].median(), label=f"PIN area {digits[:3]}xxx",
                        precision=f"approximate: no facility has PIN {digits}, used the {digits[:3]}xxx postal area ({len(g)} facilities)")
        raise ValueError(f"No facilities found near PIN {digits}")
    q = norm_place(t)
    candidates = [q] + ([ALT_NAMES[q]] if q in ALT_NAMES else []) + [k for k, v in ALT_NAMES.items() if v == q]
    for level in ["city_n", "district_n", "state_n"]:
        for cand in candidates:
            g = fac[(fac[level] == cand) & fac["coords_ok"]]
            if len(g):
                return dict(lat=g["lat"].median(), lon=g["lon"].median(), label=t.title(),
                            precision=f"centre of {len(g)} facilities listed in {level.replace('_n','')} '{cand}'")
    names = sorted((set(fac["city_n"]) | set(fac["district_n"])) - {""})
    close = difflib.get_close_matches(q, names, n=1, cutoff=0.8)
    if close:
        r = resolve_location(close[0])
        r["precision"] += f" (interpreted '{t}' as '{close[0]}')"
        return r
    raise ValueError(f"Couldn't find '{t}' in the data. Try a nearby city, a PIN code, or 'lat,lon'.")

