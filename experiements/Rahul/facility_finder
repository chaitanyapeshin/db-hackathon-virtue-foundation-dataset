# MAGIC %md
# MAGIC ## 3. Clean the data
# MAGIC What the real table looks like (from inspecting it):
# MAGIC * **Every column is a STRING** except `latitude` / `longitude` (DOUBLE). Numbers like `numberDoctors = "60"` must be converted.
# MAGIC * **Missing values are the text `"null"`**, not a real NULL, so we treat `"null"` as empty everywhere. Otherwise a city called "null" would appear.
# MAGIC * **List fields are JSON text** with repeats, e.g. `specialties = '["pediatrics","familyMedicine","familyMedicine","pediatrics"]'`.
# MAGIC   `to_list()` parses them and removes duplicates.
# MAGIC * `procedure`, `equipment` and `capability` hold **full sentences** ("Administers pediatric vaccinations"), which make good quotes to cite.
# MAGIC * Specialties are camelCase codes (`gynecologyAndObstetrics`), which we split into words so keyword matching works.
# MAGIC * `source_urls` (a JSON list, sometimes containing `null`) holds the pages the record was extracted from. That is our citation link.
# MAGIC * `address_stateOrRegion` sometimes holds a district (e.g. "Alappuzha") rather than a state. The location search checks city and region.

# COMMAND ----------

NULLS = {"", "null", "none", "nan", "[]", "{}"}

def _dedupe(items):
    seen, out = set(), []
    for x in items:
        k = x.lower()
        if k not in seen and k not in NULLS:
            seen.add(k); out.append(x)
    return out

def to_list(v):
    if v is None: return []
    if isinstance(v, float) and v != v: return []
    if isinstance(v, (list, tuple, np.ndarray)):
        return _dedupe([str(x).strip() for x in v if x is not None])
    s = str(v).strip()
    if s.lower() in NULLS: return []
    if s.startswith("["):
        try:
            return _dedupe([str(x).strip() for x in json.loads(s) if x is not None])
        except Exception:
            s = s.strip("[]")
    return _dedupe([p.strip().strip('"\'') for p in re.split(r'",\s*"|;|\|', s)])

def uncamel(s):
    return re.sub(r"(?<=[a-z])(?=[A-Z])", " ", s)

def to_text(v):
    if v is None or (isinstance(v, float) and v != v): return ""
    s = str(v).strip()
    return "" if s.lower() in NULLS else s

def to_num(v):
    try:
        x = float(str(v).replace(",", "").strip())
        return x if x == x and x > 0 else None
    except Exception:
        return None

def first_url(*values):
    """First real URL among the given fields (source_urls first, then the official website)."""
    for v in values:
        for it in to_list(v) or [to_text(v)]:
            m = re.search(r"https?://[^\s\"\],]+", it)
            if m: return m.group(0)
            if re.fullmatch(r"[\w.-]+\.[a-z]{2,}(/\S*)?", it or ""):   # bare domain like 'smsh.in'
                return "https://" + it
    return None

def norm_place(s):
    return re.sub(r"[^a-z0-9 ]", "", to_text(s).lower()).strip()

def col(name):
    return raw_pdf[C[name]] if C.get(name) else pd.Series([None] * len(raw_pdf))

fac = pd.DataFrame({
    "row_id":      col("id").astype(str) if C["id"] else pd.Series(range(len(raw_pdf))).astype(str),
    "name":        col("name").map(to_text),
    "city":        col("city").map(to_text),
    "district":    col("district").map(to_text),
    "state":       col("state").map(to_text),
    "postcode":    col("postcode").map(lambda v: re.sub(r"\D", "", to_text(v))[:6]),
    "address":     [", ".join(x for x in parts if x) for parts in zip(col("address").map(to_text), col("address2").map(to_text), col("address3").map(to_text))],
    "lat":         pd.to_numeric(col("lat"), errors="coerce"),
    "lon":         pd.to_numeric(col("lon"), errors="coerce"),
    "specialties": col("specialties").map(lambda v: [uncamel(x) for x in to_list(v)]),
    "capability":  col("capability").map(to_list),
    "procedure":   col("procedure").map(to_list),
    "equipment":   col("equipment").map(to_list),
    "description": col("description").map(to_text),
    "doctors":     col("doctors").map(to_num),
    "capacity":    col("capacity").map(to_num),
    "year":        col("year").map(to_num),
    "source_url":  [first_url(a, b) for a, b in zip(col("source_url"), col("website"))],
    "phone":       col("phone").map(to_text),
    "website":     col("website").map(lambda v: first_url(v)),
    "facility_type": col("facility_type").map(lambda v: to_text(v).lower()),
    "org_type":    col("org_type").map(lambda v: to_text(v).lower()),
    "cluster":     col("cluster").map(to_text),
    "last_post":   col("last_post").map(to_text),
})
# NGOs are organisations, not treatment sites. Keep them out of patient recommendations.
fac = fac[fac["org_type"] != "ngo"].reset_index(drop=True)
fac["city_n"] = fac["city"].map(norm_place)
fac["district_n"] = fac["district"].map(norm_place)
fac["state_n"] = fac["state"].map(norm_place)
print(len(fac), "facilities loaded")
fac.head(3)

# COMMAND ----------

# MAGIC %md
# MAGIC ## 4. Data-quality checks (the "claims, not facts" part)
# MAGIC Three problems from the brief, each turned into a flag:
# MAGIC
# MAGIC | Problem | Rule | Effect |
# MAGIC |---|---|---|
# MAGIC | **Impossible coordinates** | lat/lon outside India's bounding box (lat 6–37.5, lon 68–97.5) or exactly 0,0 | coordinates discarded; we fall back to the city's centre and say so |
# MAGIC | **Contradictory location** | point is > 60 km from the median of other facilities that list the same city (only cities with ≥ 3 facilities) | −15 points and a warning |
# MAGIC | **Duplicates / merged records** | several rows share a `cluster_id` (the dataset's own "these are the same place" grouping) or the same name + city; or the description talks about branches / a chain / multiple locations | warning; duplicates are collapsed in the results |
# MAGIC
# MAGIC The **haversine** formula below gives the great-circle distance between two lat/lon points (Earth radius ≈ 6371 km).
# MAGIC Straight-line distance underestimates road distance, often by 1.3–1.5× in India. We say this to the user instead of hiding it.

# COMMAND ----------

def haversine_km(lat1, lon1, lat2, lon2):
    lat1, lon1, lat2, lon2 = map(np.radians, [lat1, lon1, lat2, lon2])
    a = np.sin((lat2 - lat1) / 2) ** 2 + np.cos(lat1) * np.cos(lat2) * np.sin((lon2 - lon1) / 2) ** 2
    return 6371.0 * 2 * np.arcsin(np.sqrt(a))

in_india = fac["lat"].between(6, 37.5) & fac["lon"].between(68, 97.5) & ~((fac["lat"] == 0) & (fac["lon"] == 0))
fac["coords_ok"] = in_india
fac.loc[~in_india, ["lat", "lon"]] = np.nan

# City centres from the data itself (median is robust to a few bad points)
good = fac[fac["coords_ok"] & (fac["city_n"] != "")]
city_stats = good.groupby("city_n").agg(c_lat=("lat", "median"), c_lon=("lon", "median"), n=("lat", "size")).reset_index()
fac = fac.merge(city_stats, on="city_n", how="left")
fac["km_from_city_centre"] = haversine_km(fac["lat"], fac["lon"], fac["c_lat"], fac["c_lon"])
fac["location_conflict"] = (fac["n"] >= 3) & (fac["km_from_city_centre"] > 60)

# Duplicates and possible merged records
fac["name_n"] = fac["name"].map(lambda s: re.sub(r"[^a-z0-9]", "", s.lower()))
# cluster_id is the dataset's own entity-resolution group; fall back to name+city when it's missing
fac["dup_key"] = np.where(fac["cluster"] != "", "c:" + fac["cluster"], "n:" + fac["name_n"] + "|" + fac["city_n"])
fac["dup_count"] = fac.groupby("dup_key")["row_id"].transform("count")
MERGED_PAT = re.compile(r"\b(branches|chain of|group of hospitals|network of hospitals|multiple locations|units across|centres across|centers across)\b", re.I)
fac["maybe_merged"] = fac["description"].map(lambda s: bool(MERGED_PAT.search(s)))

print("bad/missing coords:", int((~fac['coords_ok']).sum()),
      "| location conflicts:", int(fac['location_conflict'].sum()),
      "| duplicate rows:", int((fac['dup_count'] > 1).sum()),
      "| possibly merged:", int(fac['maybe_merged'].sum()))

# COMMAND ----------

# MAGIC %md
# MAGIC ## 5. The service vocabulary (the knowledge we inject)
# MAGIC For each service we write two kinds of terms:
# MAGIC * **strong**: text that directly says the service is provided (a procedure, a dedicated unit, the specific machine).
# MAGIC * **support**: things that make the service *plausible* but don't prove it (the specialty, enabling equipment).
# MAGIC   Example: "nephrology" suggests dialysis but is not proof. A nephrologist may only run an outpatient clinic.
# MAGIC
# MAGIC `urgent=True` services (emergency C-section, trauma, burns) use a shorter distance scale, because time to treatment matters more there.
# MAGIC `needs_hospital=True` marks services that need an operating theatre or intensive care. A record whose `facilityTypeId` is `clinic`
# MAGIC claiming one of these is penalised (a small clinic claiming cardiac surgery is usually an extraction error or a referral).
# MAGIC **This dictionary is the easiest thing to improve.** Read real records and add terms you see.

# COMMAND ----------

SERVICES = {
    "dialysis": dict(
        aliases=["dialysis", "kidney dialysis", "haemodialysis", "hemodialysis", "renal"],
        strong=[r"h[a]?emodialysis", r"dialysis", r"\bcrrt\b", r"peritoneal dialysis", r"renal replacement"],
        support=[r"nephrology", r"nephrologist", r"kidney", r"renal"],
        urgent=False),
    "emergency c-section": dict(
        aliases=["c-section", "c section", "caesarean", "cesarean", "emergency c-section", "csection", "lscs"],
        strong=[r"c[\s-]?section", r"ca?esarean", r"\blscs\b", r"emergency obstetric", r"\bcemonc\b", r"comprehensive emergency obstetric"],
        support=[r"obstetric", r"gyn(a)?ecolog", r"maternity", r"labou?r room", r"operation theat(re|er)", r"\bot\b", r"anaesthe|anesthe", r"blood bank", r"24\s*[x/]\s*7|24 hours"],
        urgent=True, needs_hospital=True),
    "high-risk delivery": dict(
        aliases=["high risk delivery", "high-risk pregnancy", "high risk pregnancy", "maternity", "delivery"],
        strong=[r"high[\s-]?risk (pregnancy|delivery|obstetric)", r"maternal[\s-]fetal", r"fetal medicine", r"\bnicu\b", r"c[\s-]?section", r"ca?esarean"],
        support=[r"obstetric", r"gyn(a)?ecolog", r"maternity", r"labou?r room", r"neonat", r"blood bank"],
        urgent=True, needs_hospital=True),
    "nicu": dict(
        aliases=["nicu", "neonatal icu", "neonatal intensive care", "newborn icu", "sncu"],
        strong=[r"\bnicu\b", r"neonatal intensive", r"\bsncu\b", r"special newborn care", r"neonatal ventilat"],
        support=[r"neonat", r"paediatric|pediatric", r"incubator", r"phototherapy", r"radiant warmer"],
        urgent=True, needs_hospital=True),
    "cardiac surgery": dict(
        aliases=["cardiac surgery", "heart surgery", "bypass", "cabg", "open heart"],
        strong=[r"cardiac surg", r"cardiothoracic", r"\bcabg\b", r"bypass surgery", r"open[\s-]heart", r"valve replacement", r"\bctvs\b"],
        support=[r"cardiolog", r"cath(eterization)? lab", r"angioplasty", r"heart[\s-]lung machine", r"\bccu\b"],
        urgent=False, needs_hospital=True),
    "mri": dict(
        aliases=["mri", "magnetic resonance", "mri scan"],
        strong=[r"\bmri\b", r"magnetic resonance", r"\b1\.5\s*t(esla)?\b", r"\b3\s*t(esla)?\b"],
        support=[r"radiolog", r"imaging", r"\bct\b", r"diagnostic"],
        urgent=False),
    "ct scan": dict(
        aliases=["ct", "ct scan", "cat scan", "computed tomography"],
        strong=[r"\bct\b(?! ?valve)", r"ct scan", r"computed tomography", r"\bmdct\b", r"\d+[\s-]slice"],
        support=[r"radiolog", r"imaging", r"diagnostic"],
        urgent=False),
    "burn care": dict(
        aliases=["burn", "burns", "burn care", "burn unit"],
        strong=[r"burns? (unit|ward|care|centre|center|icu)", r"burn management", r"skin graft"],
        support=[r"plastic surg", r"reconstructive", r"\bicu\b", r"emergency"],
        urgent=True, needs_hospital=True),
    "trauma care": dict(
        aliases=["trauma", "accident", "trauma care", "emergency trauma", "road accident"],
        strong=[r"trauma (centre|center|care|unit|surgery)", r"\bpolytrauma\b", r"level[\s-]?[i1]+ trauma", r"casualty"],
        support=[r"emergency", r"orthop(a)?edic", r"neurosurg", r"\bicu\b", r"ct scan|\bct\b", r"blood bank", r"24\s*[x/]\s*7|24 hours", r"ambulance"],
        urgent=True, needs_hospital=True),
    "icu": dict(
        aliases=["icu", "intensive care", "critical care", "ventilator"],
        strong=[r"\bicu\b", r"intensive care", r"critical care", r"ventilator"],
        support=[r"emergency", r"anaesthe|anesthe", r"monitor"],
        urgent=True, needs_hospital=True),
}

def resolve_service(user_text):
    t = user_text.strip().lower()
    for key, spec in SERVICES.items():
        if t == key or t in spec["aliases"]:
            return key
    for key, spec in SERVICES.items():
        if any(a in t or t in a for a in spec["aliases"] + [key]):
            return key
    raise ValueError(f"Unknown service '{user_text}'. Known: {list(SERVICES)}")

# COMMAND ----------

# MAGIC %md
# MAGIC ## 6. Evidence extraction and the evidence score
# MAGIC For each facility we scan five fields. **Why these weights?** They follow *how specific* each field is. A listed procedure
# MAGIC is a concrete claim about work done. A specialty is a broad category. The description is free marketing text, so it is
# MAGIC useful for quotes but easy to inflate.
# MAGIC
# MAGIC | field | strong hit | support hit |
# MAGIC |---|---|---|
# MAGIC | procedure | 30 | 8 |
# MAGIC | equipment | 25 | 8 |
# MAGIC | capability | 25 | 6 |
# MAGIC | description | 15 | 4 |
# MAGIC | specialties | 10 | 6 |
# MAGIC
# MAGIC Each field counts **once** per kind of hit (ten mentions of "dialysis" in one description add no extra weight), so a record can't win by repetition.
# MAGIC Then we add:
# MAGIC * **+10 corroboration** if strong hits appear in ≥ 2 independent fields
# MAGIC * **+5** if a doctor count is listed, **+5** if bed capacity is listed (these show a real, staffed site)
# MAGIC * **+5** if an official phone or website is listed (the place exists and can be called to confirm)
# MAGIC * **−10** if it's listed as a *clinic* but the service needs a hospital
# MAGIC * **−15** for a location conflict, **−10** if the description suggests a merged or group record
# MAGIC * a hit preceded by a negation ("no", "not available", "referred to") within a few words is **not counted** and is shown as a warning
# MAGIC
# MAGIC The score is clipped to 0–100. **Confidence** is a separate label because the user needs it in plain words:
# MAGIC * **High**: strong hits in ≥ 2 fields, at least one of them structured (procedure / equipment / capability), and no location conflict
# MAGIC * **Medium**: at least one strong hit in a structured field, or strong hits in description + specialty
# MAGIC * **Low**: everything else (one weak mention, or only support evidence)

# COMMAND ----------

FIELD_W = {"procedure": (30, 8), "equipment": (25, 8), "capability": (25, 6), "description": (15, 4), "specialties": (10, 6)}
STRUCTURED = {"procedure", "equipment", "capability"}
NEG_PAT = re.compile(r"(\bno\b|\bnot\b|\bwithout\b|\bunavailable\b|\brefer(red|s)? (to|out)\b|\bcoming soon\b|\bplanned\b)[^.;]{0,25}$", re.I)

def _snippet(text, m, width=90):
    a, b = max(0, m.start() - width), min(len(text), m.end() + width)
    s = text[a:b].replace("\n", " ")
    return ("…" if a > 0 else "") + s + ("…" if b < len(text) else "")

def find_hits(field_value, patterns):
    """Return (list of (matched_term, quote), list of negated quotes)."""
    items = field_value if isinstance(field_value, list) else [field_value]
    hits, negated = [], []
    for item in items:
        if not item: continue
        for p in patterns:
            for m in re.finditer(p, item, re.I):
                before = item[max(0, m.start() - 40): m.start()]
                quote = item if len(item) <= 200 else _snippet(item, m)
                (negated if NEG_PAT.search(before) else hits).append((m.group(0), quote))
                break   # one hit per pattern per item is enough
    # de-duplicate quotes
    seen, uh = set(), []
    for t, q in hits:
        if q not in seen: seen.add(q); uh.append((t, q))
    return uh, negated

def score_facility(row, spec):
    evidence, warnings, breakdown = [], [], []
    strong_fields, support_fields = set(), set()
    pts = 0
    for field, (w_strong, w_support) in FIELD_W.items():
        s_hits, s_neg = find_hits(row[field], spec["strong"])
        if s_hits:
            strong_fields.add(field); pts += w_strong
            breakdown.append(f"+{w_strong} strong evidence in {field}")
            evidence += [dict(field=field, kind="strong", term=t, quote=q) for t, q in s_hits[:2]]
        else:
            p_hits, _ = find_hits(row[field], spec["support"])
            if p_hits:
                support_fields.add(field); pts += w_support
                breakdown.append(f"+{w_support} supporting evidence in {field}")
                evidence += [dict(field=field, kind="support", term=t, quote=q) for t, q in p_hits[:1]]
        for q in s_neg[:1]:
            warnings.append(f"Possible negation in {field}: “{q[1][:160]}”")
    if len(strong_fields) >= 2:
        pts += 10; breakdown.append("+10 corroborated by ≥2 independent fields")
    if pd.notna(row["doctors"]) and row["doctors"]:
        pts += 5; breakdown.append(f"+5 doctor count listed ({int(row['doctors'])})")
    if pd.notna(row["capacity"]) and row["capacity"]:
        pts += 5; breakdown.append(f"+5 bed capacity listed ({int(row['capacity'])})")
    if row["location_conflict"]:
        pts -= 15; breakdown.append("−15 coordinates disagree with stated city")
        warnings.append(f"Map location is {row['km_from_city_centre']:.0f} km from other facilities in {row['city']}. Verify the address.")
    if row["maybe_merged"]:
        pts -= 10; breakdown.append("−10 record may describe a hospital group, not one site")
        warnings.append("Description mentions branches or a group. The service may be at a different branch.")
    if spec.get("needs_hospital") and row["facility_type"] in ("clinic", "pharmacy", "doctor"):
        pts -= 10; breakdown.append(f"−10 listed as a {row['facility_type']}; this service normally needs a hospital")
        warnings.append(f"Listed as a {row['facility_type']}, which usually can't provide {spec['aliases'][0]}. Possibly a referral or a data error.")
    if any(isinstance(row[k], str) and row[k] for k in ("phone", "website")):
        pts += 5; breakdown.append("+5 contactable (official phone or website listed)")
    if row["dup_count"] > 1:
        warnings.append(f"This facility appears {int(row['dup_count'])} times in the dataset (possible duplicate records).")
    if not row["coords_ok"]:
        warnings.append("No valid coordinates. Distance is estimated from the city centre.")

    structured_strong = strong_fields & STRUCTURED
    if len(strong_fields) >= 2 and structured_strong and not row["location_conflict"]:
        conf = "High"
    elif structured_strong or {"description", "specialties"} <= strong_fields:
        conf = "Medium"
    else:
        conf = "Low"
    return dict(evidence_score=int(np.clip(pts, 0, 100)), confidence=conf, has_strong=bool(strong_fields),
                strong_fields=sorted(strong_fields), support_fields=sorted(support_fields),
                evidence=evidence, warnings=warnings, breakdown=breakdown)

